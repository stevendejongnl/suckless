+int
+systrayignored(Window w)
+{
+	XClassHint ch = { NULL, NULL };
+	unsigned int i;
+	int ignored = 0;
+
+	if (!XGetClassHint(dpy, w, &ch))
+		return 0;
+	for (i = 0; systrayignore[i]; i++)
+		if ((ch.res_name && !strcmp(ch.res_name, systrayignore[i]))
+		|| (ch.res_class && !strcmp(ch.res_class, systrayignore[i])))
+			ignored = 1;
+	if (ch.res_name)
+		XFree(ch.res_name);
+	if (ch.res_class)
+		XFree(ch.res_class);
+	return ignored;
+}
